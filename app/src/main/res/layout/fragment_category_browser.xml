<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/fragment_category_browser.xml -->
<!-- ver 1.01-151 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 上部コントロールバー -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#EEEEEE">

        <Button
            android:id="@+id/btnSwitchYahoo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ヤフオク" />

        <Button
            android:id="@+id/btnSwitchFlea"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="フリマ"
            android:layout_marginStart="4px" />

        <Button
            android:id="@+id/btnSaveCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="このカテゴリを登録"
            android:layout_marginStart="8dp"
            backgroundTint="#4CAF50" />
    </LinearLayout>

    <!-- URL確認用バー -->
    <EditText
        android:id="@+id/etUrlBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="false"
        android:textSize="12sp"
        android:padding="6dp"
        android:background="#FAFAFA"
        android:singleLine="true" />

    <!-- 内部ブラウザ -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
