<?xml version="1.0" encoding="utf-8"?>
<!--//app/src/main/res/layout/dialog_add_condition.xml-->
<!--ver 1.01-11-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <EditText
            android:id="@+id/et_pattern_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="パターン名 (例: PC周辺機器)"
            android:inputType="text" />

        <EditText
            android:id="@+id/et_search_keys"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="検索キー (スペース区切り)"
            android:layout_marginTop="8dp"
            android:inputType="text" />

        <EditText
            android:id="@+id/et_exclude_keys"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="除外キー (スペース区切り)"
            android:layout_marginTop="8dp"
            android:inputType="text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/et_min_price"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="最低価格"
                android:inputType="number" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text=" 〜 " />

            <EditText
                android:id="@+id/et_max_price"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="最高価格"
                android:inputType="number" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/cb_yahoo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ヤフオクも含める (OFFでフリマのみ)"
            android:checked="true"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>
