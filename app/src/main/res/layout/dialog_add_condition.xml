<?xml version="1.0" encoding="utf-8"?>
<!--//app/src/main/res/layout/dialog_add_condition.xml-->
<!--ver 1.01-166-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <EditText
            android:id="@+id/et_pattern_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="パターン名 (例: メモリ)"
            android:inputType="text" />

        <EditText
            android:id="@+id/et_search_keys"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="検索キー (例: DDR4 32GB)"
            android:layout_marginTop="8dp"
            android:inputType="text" />

        <EditText
            android:id="@+id/et_exclude_keys"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="除外キー (自動で-が付加されます)"
            android:layout_marginTop="8dp"
            android:inputType="text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/et_min_price"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="最低価格"
                android:inputType="number" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text=" 〜 " />

            <EditText
                android:id="@+id/et_max_price"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="最高価格"
                android:inputType="number" />
        </LinearLayout>

        <!-- カテゴリ指定フィールド ＋ 選択ボタン -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/et_categories"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="対象カテゴリID (カンマ区切り)"
                android:inputType="text" />

            <Button
                android:id="@+id/btn_select_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="選択"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- 除外カテゴリ指定フィールド ＋ 選択ボタン -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/et_exclude_categories"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="除外カテゴリID (カンマ区切り)"
                android:inputType="text" />

            <Button
                android:id="@+id/btn_select_exclude_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="選択"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="デフォルトソート順:"
            android:layout_marginTop="12dp"
            android:textSize="12sp"
            android:textColor="#666666" />

        <Spinner
            android:id="@+id/spinner_sort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <CheckBox
            android:id="@+id/cb_yahoo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ヤフオクも含める (OFFでフリマのみ)"
            android:checked="true"
            android:layout_marginTop="12dp" />

    </LinearLayout>
</ScrollView>
