<?xml version="1.0" encoding="utf-8"?>
<!--//app/src/main/res/layout/item_search_result.xml-->
<!--ver 1.01-26-->
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="10dp"
    android:layout_marginBottom="8dp"
    android:background="#FFFFFF"
    android:elevation="2dp">

    <!-- 小さな商品画像 -->
    <ImageView
        android:id="@+id/iv_item"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:scaleType="centerCrop"
        android:background="#EEEEEE"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 新規バッジ -->
    <TextView
        android:id="@+id/tv_badge_new"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=" NEW "
        android:textColor="#FFFFFF"
        android:textSize="9sp"
        android:textStyle="bold"
        android:background="#FF5722"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/iv_item"
        app:layout_constraintTop_toTopOf="@id/iv_item" />

    <!-- フリマ/オークション種別 -->
    <TextView
        android:id="@+id/tv_source"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="10sp"
        android:textStyle="bold"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp"
        android:textColor="#FFFFFF"
        app:layout_constraintStart_toEndOf="@id/iv_item"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="8dp" />

    <!-- タイトル (長文でも枠内に収まるよう制約を修正) -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="#333333"
        android:maxLines="2"
        android:ellipsize="end"
        app:layout_constraintStart_toEndOf="@id/tv_source"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="6dp" />

    <!-- 現在値・即決値・送料等の情報エリア -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintStart_toEndOf="@id/iv_item"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/tv_current_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#D32F2F"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_prompt_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#666666"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
